/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Fonts are fingerprinted by content and never change in place.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

# Markdown twins of the pages, for AI agents. index.md is about a fifth the
# size of index.html, so an assistant reading it spends far fewer tokens and
# is more likely to take in the whole thing.
/index.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/subscribe.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Advertise the markdown version and the site summary in the HTTP response
# itself, per RFC 8288, so an agent finds them without parsing any HTML.
/
  Link: </index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="alternate"; type="text/plain"
  Vary: Accept

/index.html
  Link: </index.md>; rel="alternate"; type="text/markdown"
  Vary: Accept

/subscribe.html
  Link: </subscribe.md>; rel="alternate"; type="text/markdown"
  Vary: Accept
